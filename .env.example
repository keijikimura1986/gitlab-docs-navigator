GITLAB_URL=https://gitlab.example.com
GITLAB_GROUP=your-group
# Public repositories do not require a token.
GITLAB_TOKEN=
# Branch opened by the "Open in GitLab" button: main or draft.
GITLAB_LINK_BRANCH=main

# Optional settings
DOC_EXTENSIONS=.md,.mdx,.txt,.rst,.adoc
DOC_MAX_BYTES=1000000
CACHE_TTL_SECONDS=300
CACHE_DIR=.cache
HOST=127.0.0.1
PORT=8000
